<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EndlessSudoku</PackageId>
    <Version>1.2.0</Version>
    <Authors>Parsa Karami</Authors>
    <Description>Sudoku generator and solver for .NET. Generates 9x9 and 6x6 puzzles with difficulty 1-10, always with exactly one solution. Includes solving, validation, hints and board formatting.</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <RepositoryUrl>https://github.com/Parsakarami/EndlessSudokuLibrary</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageTags>sudoku;game;engine;puzzle;generator;solver</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Parsakarami/EndlessSudokuLibrary</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>endless-sudoku-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
        <None Include="endless-sudoku-icon.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
