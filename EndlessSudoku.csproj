<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>EndlessSudoku</PackageId>
    <Version>1.1.2</Version>
    <Authors>Parsa Karami</Authors>
    <Description>Sudoku generation library for C#</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <RepositoryUrl>https://github.com/Parsakarami/EndlessSudokuLibrary</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageTags>sudoku;game;engine</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Parsakarami/EndlessSudokuLibrary</PackageProjectUrl>
    
    <PackageIcon>endless-sudoku-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
        <None Include="endless-sudoku-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
